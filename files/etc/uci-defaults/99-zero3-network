#!/bin/sh

# This file is injected by GitHub Actions after replacing __INITIAL_WIFI_PSK__.
# It runs once on the target's first boot and is removed by uci-defaults.
set -eu

[ -s /etc/config/wireless ] || wifi config

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.50.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q set dhcp.lan.interface='lan'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.ignore

uci -q set wireless.@wifi-device[0].country='CN'
uci -q set wireless.@wifi-device[0].channel='1'
uci -q set wireless.@wifi-device[0].htmode='HT20'
uci -q set wireless.@wifi-device[0].disabled='0'
uci -q set wireless.@wifi-iface[0].device='radio0'
uci -q set wireless.@wifi-iface[0].network='lan'
uci -q set wireless.@wifi-iface[0].mode='ap'
uci -q set wireless.@wifi-iface[0].ssid='Zero3'
uci -q set wireless.@wifi-iface[0].encryption='psk2'
uci -q set wireless.@wifi-iface[0].key='__INITIAL_WIFI_PSK__'
uci -q set wireless.@wifi-iface[0].disabled='0'

uci commit network
uci commit dhcp
uci commit wireless

exit 0
