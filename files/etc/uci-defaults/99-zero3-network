#!/bin/sh

# This file is injected by GitHub Actions after replacing __INITIAL_WIFI_PSK__.
# It runs once on the target's first boot and is removed by uci-defaults.
set -eu

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.50.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q set dhcp.lan.interface='lan'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.ignore || true

uci commit network
uci commit dhcp

# UWE5622 appears after uci-defaults runs.  Do not call "wifi config" here:
# it would create the stock ImmortalWrt SSID later and race our AP manager.
cat > /etc/config/wireless <<'EOF'
config wifi-device 'disabled'
	option disabled '1'
EOF

cat > /etc/zero3-hostapd.conf <<EOF
interface=__ZERO3_WIFI_IFACE__
bridge=br-lan
driver=nl80211
country_code=CN
ieee80211d=1
hw_mode=g
channel=1
ieee80211n=1
ht_capab=[HT20]
ssid=Zero3
auth_algs=1
wpa=2
wpa_passphrase=__INITIAL_WIFI_PSK__
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF
chmod 0600 /etc/zero3-hostapd.conf

/etc/init.d/wpad disable || true
/etc/init.d/zero3-ap enable
exit 0
