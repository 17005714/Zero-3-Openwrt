#!/bin/sh

set -u

for attempt in $(seq 1 90); do
	for path in /sys/class/net/wlan*; do
		[ -e "$path" ] || continue
		interface="${path##*/}"
		break 2
	done
	sleep 1
done

if [ -z "${interface:-}" ]; then
	logger -t zero3-ap 'UWE5622 interface did not appear within 90 seconds'
	exit 1
fi

for attempt in $(seq 1 30); do
	[ -d /sys/class/net/br-lan ] && break
	sleep 1
done

if [ ! -d /sys/class/net/br-lan ]; then
	logger -t zero3-ap 'br-lan did not appear; refusing to start an unbridged AP'
	exit 1
fi

sed "s/__ZERO3_WIFI_IFACE__/$interface/" /etc/zero3-hostapd.conf > /var/run/zero3-hostapd.conf
ip link set dev "$interface" up
logger -t zero3-ap "starting standalone hostapd on $interface"
exec /usr/sbin/hostapd /var/run/zero3-hostapd.conf
